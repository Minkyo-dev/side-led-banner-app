{
  "expo": {
    "name": "Led Pop",
    "slug": "side-led-banner-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/Logo_IOS.png",
    "scheme": "sideledbannerapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/LOGO_05_Final.png",
      "bundleIdentifier": "com.minkyokim.sideledbannerapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/LOGO_05_Final.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.minkyokim.sideledbannerapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set the banner background.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera for the banner background."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "dark": {
            "backgroundColor": "#1a1a1a"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3506417530430977~7354080715",
          "iosAppId": "ca-app-pub-3506417530430977~1773312905"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8c4d515-3a65-40bb-8748-869e651c979f"
      }
    }
  }
}
